# ══════════════════════════════════════════════
#  RESEND — Recuperação de Senha Reset 7D
# ══════════════════════════════════════════════

# 1. Crie conta em: https://resend.com  (plano gratuito: 3.000 e-mails/mês)
# 2. API Keys → Create API Key
#    Nome: Reset7D  |  Permissão: Full Access (ou "Sending access")
# 3. Cole a chave abaixo (começa com re_)
RESEND_API_KEY=re_COLE_SUA_CHAVE_AQUI

# 4. Para enviar a QUALQUER destinatário:
#    Adicione e verifique seu domínio em: https://resend.com/domains
#    Depois use: FROM_EMAIL=seuemail@seudominio.com
#
#    Sem domínio verificado, use: onboarding@resend.dev
#    (só envia para o e-mail da sua conta Resend)
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Reset 7D

# Porta local (padrão: 3001)
PORT=3001

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=string_longa_aleatoria_min_32_chars

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://seudominio.com.br

# ── App URL (para link de reset de senha) ─────────────────────
APP_URL=https://seudominio.com.br

# ── Webhook de Pagamento (Hotmart / Kiwify) ───────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cole o mesmo token no painel da plataforma de pagamento.
WEBHOOK_TOKEN=token_secreto_aleatorio_aqui
