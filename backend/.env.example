# ══════════════════════════════════════════════════════════════════
#  Reset 7D — Variáveis de Ambiente (backend)
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA commite o arquivo .env — ele está no .gitignore.
# ══════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────
#  VARIÁVEIS SERVER-ONLY
#  ⛔  Nunca exponha estes valores no frontend, logs públicos ou
#      respostas HTTP enviadas ao browser.
# ──────────────────────────────────────────────────────────────────

# Supabase — Service Role Key
#   Painel Supabase → Project Settings → API → service_role (secret)
#   Dá acesso irrestrito ao banco; use APENAS no backend.
SUPABASE_SERVICE_ROLE_KEY=

# Autenticação JWT
#   Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   Mínimo recomendado: 64 caracteres aleatórios.
JWT_SECRET=

# Resend — API Key para envio de e-mail
#   Painel Resend → API Keys → Create API Key
#   A chave começa com re_
RESEND_API_KEY=

# Remetente dos e-mails de recuperação de senha
#   FROM_EMAIL deve ser um endereço verificado no seu domínio Resend.
#   Sem domínio verificado, use: onboarding@resend.dev
#   (apenas envia para o e-mail da sua conta Resend)
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Reset 7D


# ──────────────────────────────────────────────────────────────────
#  VARIÁVEIS PÚBLICAS
#  ✅  Não contêm secrets. Em Next.js equivaleriam a NEXT_PUBLIC_*.
#      Podem aparecer em logs e mensagens de diagnóstico.
# ──────────────────────────────────────────────────────────────────

# Supabase — URL pública do projeto
#   Painel Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase — Anon (public) key  [OPCIONAL]
#   Painel Supabase → Project Settings → API → anon (public)
#   Necessária apenas se usar supabase/server.js com Row Level Security (RLS).
#   Não é um secret — pode aparecer em logs, mas não deve substituir a service_role key.
SUPABASE_ANON_KEY=


# ──────────────────────────────────────────────────────────────────
#  CONFIGURAÇÃO DE SERVIDOR (opcionais — têm valor padrão)
# ──────────────────────────────────────────────────────────────────

# Porta local do backend (padrão: 3001)
PORT=3001

# URL base do app em produção — usada nos links de e-mail de recuperação
#   Exemplo: https://reset-7d.vercel.app
#   Em desenvolvimento deixe vazio (usa http://localhost:PORT)
APP_URL=

# Origens permitidas no CORS (separadas por vírgula)
#   Exemplo produção: https://reset-7d.vercel.app
#   Desenvolvimento: http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
