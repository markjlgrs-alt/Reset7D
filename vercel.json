{
  "version": 2,
  "builds": [
    { "src": "backend/server.js", "use": "@vercel/node" },
    { "src": "*.{html,css,js,jpg,jpeg,png,webp,svg,gif,ico}", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/server.js" },
    { "src": "/demo.html", "dest": "/app.html" },
    { "src": "/recuperar-senha-demo.html", "dest": "/app.html" },
    { "src": "/", "dest": "/app.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
